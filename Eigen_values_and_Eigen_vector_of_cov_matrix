C = [
    [9.0670, -10.0768, -0.7268],
    [-10.0768, 159.1250, 123.0536],
    [-0.7268, 123.0536, 684.6964]
]



# POWER ITERATION WITH MATRIX DEFLATION

print("EXTRACTING EIGENVALUES & EIGENVECTORS ")

# We create a working copy of the matrix that we will deflate step-by-step
current_matrix = [
    [C[0][0], C[0][1], C[0][2]],
    [C[1][0], C[1][1], C[1][2]],
    [C[2][0], C[2][1], C[2][2]]
]

# Extract all 3 components one by one
for comp in range(1, 4):
    # 1. Initialize guess vector
    v = [1.0, 1.0, 1.0]
    
    # 2. Iterate to align vector with the dominant mode
    for _ in range(60):
        # Matrix-Vector Multiplication: Av = current_matrix * v
        Av = [
            current_matrix[0][0]*v[0] + current_matrix[0][1]*v[1] + current_matrix[0][2]*v[2],
            current_matrix[1][0]*v[0] + current_matrix[1][1]*v[1] + current_matrix[1][2]*v[2],
            current_matrix[2][0]*v[0] + current_matrix[2][1]*v[1] + current_matrix[2][2]*v[2]
        ]
        
        # Calculate length (norm) using primitive exponentiation
        magnitude = (Av[0]**2 + Av[1]**2 + Av[2]**2) ** 0.5
        
        # Check to prevent division by zero for exhausted matrices
        if magnitude < 1e-9:
            break
            
        # Normalize the vector
        v = [Av[0] / magnitude, Av[1] / magnitude, Av[2] / magnitude]
        
    # 3. Calculate Eigenvalue using Rayleigh Quotient: lam = v . (A * v)
    Av_final = [
        current_matrix[0][0]*v[0] + current_matrix[0][1]*v[1] + current_matrix[0][2]*v[2],
        current_matrix[1][0]*v[0] + current_matrix[1][1]*v[1] + current_matrix[1][2]*v[2],
        current_matrix[2][0]*v[0] + current_matrix[2][1]*v[1] + current_matrix[2][2]*v[2]
    ]
    lam = v[0]*Av_final[0] + v[1]*Av_final[1] + v[2]*Av_final[2]
    
    # Enforce standard orientation (make the largest magnitude component positive)
    max_idx = 0
    max_val = v[0] if v[0] >= 0 else -v[0]
    for k in range(1, 3):
        abs_k = v[k] if v[k] >= 0 else -v[k]
        if abs_k > max_val:
            max_val = abs_k
            max_idx = k
    if v[max_idx] < 0:
        v = [-v[0], -v[1], -v[2]]

    print(f"Component {comp}:")
    print(f"  Eigenvalue (λ) = {lam:.4f}")
    print(f"  Eigenvector (v) = [{v[0]:.4f}, {v[1]:.4f}, {v[2]:.4f}]")
    print()
    
    # 4. DEFLATION STEP: Remove the current mode from the matrix
    # Matrix subtraction: A_new = A - lam * (v * v^T)
    outer_product = [
        [v[0]*v[0], v[0]*v[1], v[0]*v[2]],
        [v[1]*v[0], v[1]*v[1], v[1]*v[2]],
        [v[2]*v[0], v[2]*v[1], v[2]*v[2]]
    ]
    
    for r in range(3):
        for c in range(3):
            current_matrix[r][c] -= lam * outer_product[r][c]
